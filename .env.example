# Copiá este archivo como ".env.local" para desarrollo local.
# En GitHub, estos valores van en Settings > Secrets and variables > Actions > Variables
# (son públicos por diseño: la seguridad la dan las políticas RLS).

# Supabase > Project Settings > API > Project URL
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Supabase > Project Settings > API > "anon" public key (o publishable key)
# NUNCA pongas acá la service_role key ni claves de proveedores de IA.
VITE_SUPABASE_ANON_KEY=

# Solo desarrollo local (en GitHub Pages lo define el workflow automáticamente)
# VITE_BASE=/
